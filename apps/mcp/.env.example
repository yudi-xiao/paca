# Choose exactly one authentication mode.

# Agent Auth mode for a controlled local Codex, Claude Code, DeepSeek, or custom Harness.
# The enrollment file must be a regular, non-symlink file with mode 0600.
# PACA_AGENT_CONFIG=/absolute/path/to/delegated-agent.json
# PACA_AGENT_HARNESS_KIND=codex
# PACA_AGENT_HARNESS_VERSION=1.0.0
# PACA_AGENT_HARNESS_INSTANCE_ID=local-machine-1

# Legacy user/integration mode.
# Create an API key in the Paca web interface: Settings > API Keys
PACA_API_KEY=your-api-key-here

# Paca API URL (optional)
# Default: http://localhost:8080
PACA_API_URL=http://localhost:8080
