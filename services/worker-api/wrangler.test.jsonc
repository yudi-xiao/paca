{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paca-worker-api-test",
  "main": "test/workers/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "producers": [
      {
        "binding": "REALTIME_EVENTS",
        "queue": "paca-realtime-events-test"
      },
      {
        "binding": "DOCUMENT_MATERIALIZATION",
        "queue": "paca-document-materialization-test"
      }
    ],
    "consumers": [
      {
        "queue": "paca-realtime-events-test",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      },
      {
        "queue": "paca-document-materialization-test",
        "max_batch_size": 5,
        "max_batch_timeout": 2
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "DOCUMENT_SNAPSHOTS",
      "bucket_name": "paca-document-snapshots-test"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ProjectParty",
        "class_name": "ProjectParty"
      },
      {
        "name": "UserParty",
        "class_name": "UserParty"
      },
      {
        "name": "DocumentParty",
        "class_name": "DocumentParty"
      },
      {
        "name": "AgentCoordinator",
        "class_name": "AgentCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-realtime-parties",
      "new_sqlite_classes": ["ProjectParty", "UserParty"]
    },
    {
      "tag": "v2-document-party",
      "new_sqlite_classes": ["DocumentParty"]
    },
    {
      "tag": "v3-agent-coordinator",
      "new_sqlite_classes": ["AgentCoordinator"]
    }
  ]
}
