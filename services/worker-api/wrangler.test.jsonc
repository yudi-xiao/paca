{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paca-worker-api-test",
  "main": "test/workers/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "producers": [
      {
        "binding": "REALTIME_EVENTS",
        "queue": "paca-realtime-events-test"
      }
    ],
    "consumers": [
      {
        "queue": "paca-realtime-events-test",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ProjectParty",
        "class_name": "ProjectParty"
      },
      {
        "name": "UserParty",
        "class_name": "UserParty"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-realtime-parties",
      "new_sqlite_classes": ["ProjectParty", "UserParty"]
    }
  ]
}
