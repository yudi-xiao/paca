{
  "name": "@paca/worker-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local",
    "deploy:guard": "bun run scripts/assert-production-config.ts",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "types": "wrangler types worker-configuration.d.ts",
    "types:check": "wrangler types worker-configuration.d.ts --check",
    "db:migrate:prod": "bun run scripts/apply-production-migrations.ts",
    "github:app:setup": "bun run scripts/setup-github-app.ts",
    "github:app:verify": "bun run scripts/verify-github-app.ts",
    "github:app:webhooks": "bun run scripts/inspect-github-app-webhooks.ts",
    "github:app:webhook-config": "bun run scripts/configure-github-app-webhook.ts",
    "smoke:github-repository:prod": "bun run scripts/smoke-github-repository-prod.ts",
    "db:inspect:production": "bun run scripts/inspect-production-consumers.ts",
    "auth:schema:generate": "auth generate --config src/auth/schema.config.ts --output src/db/schema/auth.ts --yes",
    "db:generate": "DATABASE_URL=postgresql://schema:generator@127.0.0.1:5432/paca drizzle-kit generate --config drizzle.config.ts",
    "db:check": "DATABASE_URL=postgresql://schema:generator@127.0.0.1:5432/paca drizzle-kit check --config drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:postgres:prepare": "bun run scripts/prepare-postgres-test-database.ts",
    "test:postgres:recovery": "bun run scripts/exercise-postgres-migration-recovery.ts",
    "test:postgres": "bun run test:postgres:prepare && PACA_REQUIRE_POSTGRES_CONTRACTS=true vitest run test/postgres && bun run test:postgres:recovery",
    "test:workers": "vitest run --config vitest.workers.config.ts --max-workers=1 --no-isolate",
    "test:watch": "vitest",
    "smoke:prod": "bun run scripts/smoke-prod.ts",
    "smoke:permission:prod": "bun run scripts/smoke-permission-prod.ts",
    "smoke:realtime:prod": "bun run scripts/smoke-realtime-prod.ts",
    "smoke:attachment:prod": "bun run scripts/smoke-attachment-prod.ts",
    "smoke:agent-audit:prod": "bun run scripts/smoke-agent-audit-prod.ts",
    "smoke:document:prod": "bun run scripts/smoke-document-prod.ts",
    "smoke:agent-workflow:prod": "bun run scripts/smoke-agent-workflow-prod.ts",
    "smoke:agent-task-harness:prod": "bun run scripts/smoke-agent-task-harness-prod.ts",
    "smoke:agent-task-recovery:prod": "bun run scripts/smoke-agent-task-recovery-prod.ts",
    "smoke:environment:prod": "bun run scripts/smoke-environment-prod.ts",
    "smoke:project-agent-directory:database": "bun run scripts/smoke-project-agent-directory-database.ts",
    "smoke:project-agent-directory:prod": "bun run scripts/smoke-project-agent-directory-prod.ts",
    "smoke:notification:database": "bun run scripts/smoke-notification-database.ts",
    "smoke:notification:prod": "bun run scripts/smoke-notification-prod.ts",
    "smoke:branding:prod": "bun run scripts/smoke-branding-prod.ts",
    "smoke:task:database": "bun run scripts/smoke-task-database.ts",
    "smoke:automation:prod": "bun run scripts/smoke-automation-prod.ts",
    "smoke:search:prod": "bun run scripts/smoke-search-prod.ts",
    "github:delivery:inspect": "bun run scripts/inspect-github-delivery.ts",
    "agent-host:enroll": "bun run scripts/enroll-agent-host.ts",
    "agent:register:demo": "bun run scripts/register-demo-agent.ts",
    "agent:approval:refresh": "bun run scripts/refresh-agent-approval.ts",
    "agent:approve:prod": "bun run scripts/approve-agent-prod.ts",
    "agent:status": "bun run scripts/agent-status.ts",
    "agent:execute": "bun run scripts/execute-agent-actions.ts",
    "agent:tasks": "bun run scripts/discover-agent-tasks.ts",
    "agent:task-lease": "bun run scripts/execute-agent-task-lease.ts",
    "check": "bun run build:web:production && bun run types:check && bun run deploy:guard && bun run db:check && bun run typecheck && bun run lint && bun run test && bun run test:workers && bun run deploy:dry-run",
    "build:web:production": "cd ../../apps/web && bunx tsc -b && VITE_PACA_RUNTIME=cloudflare bunx vite build",
    "deploy:prod": "bun run build:web:production && bun run deploy:guard && wrangler deploy --profile paca",
    "smoke:production": "bun run scripts/smoke-production.ts"
  },
  "dependencies": {
    "@better-auth/agent-auth": "0.6.2",
    "agents": "0.22.0",
    "better-auth": "1.7.2",
    "cron-parser": "5.10.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "partyserver": "0.5.10",
    "pg": "8.23.0",
    "y-partyserver": "2.2.0",
    "yjs": "13.6.30",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@better-auth/memory-adapter": "1.7.2",
    "@biomejs/biome": "2.4.12",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@types/node": "26.4.0",
    "@types/pg": "8.15.6",
    "auth": "1.7.2",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
