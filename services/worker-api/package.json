{
  "name": "@paca/worker-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local",
    "build:web:internal": "cd ../../apps/web && bunx tsc -b && VITE_PACA_RUNTIME=cloudflare VITE_INTERNAL_PREVIEW=true bunx vite build",
    "deploy:internal": "bun run build:web:internal && bun run deploy:guard && wrangler deploy --env internal",
    "deploy:guard": "bun run scripts/assert-internal-config.ts",
    "deploy:dry-run": "wrangler deploy --dry-run --env internal",
    "types": "wrangler types worker-configuration.d.ts",
    "types:check": "wrangler types worker-configuration.d.ts --check",
    "db:migrate:internal": "bun run scripts/apply-internal-migrations.ts",
    "github:app:setup": "bun run scripts/setup-github-app.ts",
    "github:app:setup:production": "PACA_GITHUB_APP_ENVIRONMENT=production bun run scripts/setup-github-app.ts",
    "github:app:verify": "bun run scripts/verify-github-app.ts",
    "github:app:verify:production-installation": "PACA_GITHUB_APP_ENVIRONMENT=production bun run scripts/verify-github-app.ts --installation-only",
    "github:app:webhooks": "bun run scripts/inspect-github-app-webhooks.ts",
    "github:app:webhook-config": "bun run scripts/configure-github-app-webhook.ts",
    "smoke:github-repository:internal": "bun run scripts/smoke-github-repository-internal.ts",
    "db:reset:internal": "bun run scripts/reset-internal-database.ts",
    "db:inspect:production": "bun run scripts/inspect-production-consumers.ts",
    "db:initialize:production": "bun run scripts/initialize-production-database.ts",
    "auth:owner:production": "bun run scripts/setup-production-owner.ts",
    "auth:schema:generate": "auth generate --config src/auth/schema.config.ts --output src/db/schema/auth.ts --yes",
    "db:generate": "DATABASE_URL=postgresql://schema:generator@127.0.0.1:5432/paca drizzle-kit generate --config drizzle.config.ts",
    "db:check": "DATABASE_URL=postgresql://schema:generator@127.0.0.1:5432/paca drizzle-kit check --config drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:postgres:prepare": "bun run scripts/prepare-postgres-test-database.ts",
    "test:postgres:recovery": "bun run scripts/exercise-postgres-migration-recovery.ts",
    "test:postgres": "bun run test:postgres:prepare && PACA_REQUIRE_POSTGRES_CONTRACTS=true vitest run test/postgres && bun run test:postgres:recovery",
    "test:workers": "vitest run --config vitest.workers.config.ts --max-workers=1 --no-isolate",
    "test:watch": "vitest",
    "smoke:internal": "bun run scripts/smoke-internal.ts",
    "smoke:permission:internal": "bun run scripts/smoke-permission-internal.ts",
    "smoke:realtime:internal": "bun run scripts/smoke-realtime-internal.ts",
    "smoke:attachment:internal": "bun run scripts/smoke-attachment-internal.ts",
    "smoke:agent-audit:internal": "bun run scripts/smoke-agent-audit-internal.ts",
    "smoke:document:internal": "bun run scripts/smoke-document-internal.ts",
    "smoke:agent-workflow:internal": "bun run scripts/smoke-agent-workflow-internal.ts",
    "smoke:agent-task-harness:internal": "bun run scripts/smoke-agent-task-harness-internal.ts",
    "smoke:agent-task-recovery:internal": "bun run scripts/smoke-agent-task-recovery-internal.ts",
    "smoke:environment:internal": "bun run scripts/smoke-environment-internal.ts",
    "smoke:project-agent-directory:database": "bun run scripts/smoke-project-agent-directory-database.ts",
    "smoke:project-agent-directory:internal": "bun run scripts/smoke-project-agent-directory-internal.ts",
    "smoke:notification:database": "bun run scripts/smoke-notification-database.ts",
    "smoke:notification:internal": "bun run scripts/smoke-notification-internal.ts",
    "smoke:branding:internal": "bun run scripts/smoke-branding-internal.ts",
    "smoke:task:database": "bun run scripts/smoke-task-database.ts",
    "smoke:automation:internal": "bun run scripts/smoke-automation-internal.ts",
    "smoke:search:internal": "bun run scripts/smoke-search-internal.ts",
    "github:delivery:inspect": "bun run scripts/inspect-github-delivery.ts",
    "agent-host:enroll": "bun run scripts/enroll-agent-host.ts",
    "agent:register:demo": "bun run scripts/register-demo-agent.ts",
    "agent:approval:refresh": "bun run scripts/refresh-agent-approval.ts",
    "agent:approve:internal": "bun run scripts/approve-agent-internal.ts",
    "agent:status": "bun run scripts/agent-status.ts",
    "agent:execute": "bun run scripts/execute-agent-actions.ts",
    "agent:tasks": "bun run scripts/discover-agent-tasks.ts",
    "agent:task-lease": "bun run scripts/execute-agent-task-lease.ts",
    "check": "bun run build:web:internal && bun run types:check && bun run deploy:guard:production && bun run db:check && bun run typecheck && bun run lint && bun run test && bun run test:workers && bun run deploy:dry-run",
    "dev:internal": "wrangler dev --remote --env internal",
    "build:web:production": "cd ../../apps/web && bunx tsc -b && VITE_PACA_RUNTIME=cloudflare VITE_INTERNAL_PREVIEW=false bunx vite build",
    "deploy:guard:production": "bun run scripts/assert-production-config.ts candidate",
    "deploy:guard:release": "bun run scripts/assert-production-config.ts release",
    "deploy:dry-run:production": "bun run deploy:guard:production && wrangler deploy --dry-run --env production"
  },
  "dependencies": {
    "@better-auth/agent-auth": "0.6.2",
    "agents": "0.22.0",
    "better-auth": "1.7.2",
    "cron-parser": "5.10.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "partyserver": "0.5.10",
    "pg": "8.23.0",
    "y-partyserver": "2.2.0",
    "yjs": "13.6.30",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@better-auth/memory-adapter": "1.7.2",
    "@biomejs/biome": "2.4.12",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@types/node": "26.4.0",
    "@types/pg": "8.15.6",
    "auth": "1.7.2",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
