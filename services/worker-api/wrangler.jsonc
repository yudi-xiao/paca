{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paca-worker-api",
  "account_id": "25f556b8c06e910fb3115a6c47c25bf9",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/health", "/internal/*", "/ws/*"]
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TASK_ATTACHMENTS",
      "bucket_name": "paca-attachments-development"
    },
    {
      "binding": "DOCUMENT_SNAPSHOTS",
      "bucket_name": "paca-document-snapshots-development"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REALTIME_EVENTS",
        "queue": "paca-realtime-events-development"
      },
      {
        "binding": "DOCUMENT_MATERIALIZATION",
        "queue": "paca-document-materialization-development"
      },
      {
        "binding": "AUTOMATION_EVENTS",
        "queue": "paca-automation-events-development"
      }
    ],
    "consumers": [
      {
        "queue": "paca-realtime-events-development",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 5,
        "dead_letter_queue": "paca-realtime-events-development-dlq"
      },
      {
        "queue": "paca-document-materialization-development",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "retry_delay": 5,
        "dead_letter_queue": "paca-document-materialization-development-dlq"
      },
      {
        "queue": "paca-automation-events-development",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "retry_delay": 5,
        "dead_letter_queue": "paca-automation-events-development-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ProjectParty",
        "class_name": "ProjectParty"
      },
      {
        "name": "UserParty",
        "class_name": "UserParty"
      },
      {
        "name": "DocumentParty",
        "class_name": "DocumentParty"
      },
      {
        "name": "AgentCoordinator",
        "class_name": "AgentCoordinator"
      }
    ]
  },
  "workflows": [
    {
      "binding": "DOCUMENT_AGENT_WORKFLOW",
      "name": "paca-document-agent-development",
      "class_name": "DocumentAgentWorkflow"
    },
    {
      "binding": "AUTOMATION_WORKFLOW",
      "name": "paca-automation-development",
      "class_name": "AutomationWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1-realtime-parties",
      "new_sqlite_classes": ["ProjectParty", "UserParty"]
    },
    {
      "tag": "v2-document-party",
      "new_sqlite_classes": ["DocumentParty"]
    },
    {
      "tag": "v3-agent-coordinator",
      "new_sqlite_classes": ["AgentCoordinator"]
    }
  ],
  "env": {
    "internal": {
      "name": "paca-worker-api-internal",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "paca.howlearnwood.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ATTACHMENT_CLEANUP_ENABLED": "true",
        "BETTER_AUTH_URL": "https://paca.howlearnwood.com",
        "ENVIRONMENT": "internal",
        "TRUSTED_ORIGINS": "https://paca.howlearnwood.com"
      },
      "triggers": {
        "crons": ["* * * * *", "15 10 * * *"]
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "ec828e1b80664166ab38aa511cfd1f82"
        }
      ],
      "services": [
        {
          "binding": "ENVIRONMENT_GATEWAY",
          "service": "paca-environment-gateway-internal"
        }
      ],
      "r2_buckets": [
        {
          "binding": "TASK_ATTACHMENTS",
          "bucket_name": "paca-attachments-internal"
        },
        {
          "binding": "DOCUMENT_SNAPSHOTS",
          "bucket_name": "paca-document-snapshots-internal"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "REALTIME_EVENTS",
            "queue": "paca-realtime-events-internal"
          },
          {
            "binding": "DOCUMENT_MATERIALIZATION",
            "queue": "paca-document-materialization-internal"
          },
          {
            "binding": "AUTOMATION_EVENTS",
            "queue": "paca-automation-events-internal"
          }
        ],
        "consumers": [
          {
            "queue": "paca-realtime-events-internal",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "retry_delay": 5,
            "dead_letter_queue": "paca-realtime-events-internal-dlq"
          },
          {
            "queue": "paca-document-materialization-internal",
            "max_batch_size": 5,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "retry_delay": 5,
            "dead_letter_queue": "paca-document-materialization-internal-dlq"
          },
          {
            "queue": "paca-automation-events-internal",
            "max_batch_size": 10,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "retry_delay": 5,
            "dead_letter_queue": "paca-automation-events-internal-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ProjectParty",
            "class_name": "ProjectParty"
          },
          {
            "name": "UserParty",
            "class_name": "UserParty"
          },
          {
            "name": "DocumentParty",
            "class_name": "DocumentParty"
          },
          {
            "name": "AgentCoordinator",
            "class_name": "AgentCoordinator"
          }
        ]
      },
      "workflows": [
        {
          "binding": "DOCUMENT_AGENT_WORKFLOW",
          "name": "paca-document-agent-internal",
          "class_name": "DocumentAgentWorkflow"
        },
        {
          "binding": "AUTOMATION_WORKFLOW",
          "name": "paca-automation-internal",
          "class_name": "AutomationWorkflow"
        }
      ]
    },
    "production": {
      "name": "paca-worker-api-production",
      "workers_dev": false,
      "routes": [],
      "vars": {
        "ATTACHMENT_CLEANUP_ENABLED": "true",
        "BETTER_AUTH_URL": "https://paca.howlearnwood.com",
        "ENVIRONMENT": "production",
        "TRUSTED_ORIGINS": "https://paca.howlearnwood.com"
      },
      "triggers": {
        "crons": ["* * * * *", "15 10 * * *"]
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "98086061f9064f6c8f815303002c4a88"
        }
      ],
      "services": [
        {
          "binding": "ENVIRONMENT_GATEWAY",
          "service": "paca-environment-gateway-production"
        }
      ],
      "r2_buckets": [
        {
          "binding": "TASK_ATTACHMENTS",
          "bucket_name": "paca-attachments-production"
        },
        {
          "binding": "DOCUMENT_SNAPSHOTS",
          "bucket_name": "paca-document-snapshots-production"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "REALTIME_EVENTS",
            "queue": "paca-realtime-events-production"
          },
          {
            "binding": "DOCUMENT_MATERIALIZATION",
            "queue": "paca-document-materialization-production"
          },
          {
            "binding": "AUTOMATION_EVENTS",
            "queue": "paca-automation-events-production"
          }
        ],
        "consumers": [
          {
            "queue": "paca-realtime-events-production",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "retry_delay": 5,
            "dead_letter_queue": "paca-realtime-events-production-dlq"
          },
          {
            "queue": "paca-document-materialization-production",
            "max_batch_size": 5,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "retry_delay": 5,
            "dead_letter_queue": "paca-document-materialization-production-dlq"
          },
          {
            "queue": "paca-automation-events-production",
            "max_batch_size": 10,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "retry_delay": 5,
            "dead_letter_queue": "paca-automation-events-production-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ProjectParty",
            "class_name": "ProjectParty"
          },
          {
            "name": "UserParty",
            "class_name": "UserParty"
          },
          {
            "name": "DocumentParty",
            "class_name": "DocumentParty"
          },
          {
            "name": "AgentCoordinator",
            "class_name": "AgentCoordinator"
          }
        ]
      },
      "workflows": [
        {
          "binding": "DOCUMENT_AGENT_WORKFLOW",
          "name": "paca-document-agent-production",
          "class_name": "DocumentAgentWorkflow"
        },
        {
          "binding": "AUTOMATION_WORKFLOW",
          "name": "paca-automation-production",
          "class_name": "AutomationWorkflow"
        }
      ]
    }
  },
  "routes": []
}
