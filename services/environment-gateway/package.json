{
  "name": "@paca/environment-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy:dry-run": "wrangler deploy --dry-run",
    "types": "wrangler types worker-configuration.d.ts",
    "types:check": "wrangler types worker-configuration.d.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "check": "bun run types:check && bun run typecheck && bun run lint && bun run test && bun run deploy:dry-run",
    "deploy:prod": "wrangler deploy --profile paca --containers-rollout=immediate"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9",
    "hono": "4.13.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "typescript": "5.9.3",
    "@types/node": "26.4.0",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
